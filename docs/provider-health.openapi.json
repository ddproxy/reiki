{
  "components": {
    "schemas": {
      "Error": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": true,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          },
          "ok": {
            "const": false,
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "peerAuth": {
        "description": "The read-only peer token; accepted on the peer listener only",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Contract for the read-only peer listener health document. Readers must ignore unknown fields and unknown enum-like values. Optional fields may be absent; host and sessions are non-core extensions and are off by default.",
    "title": "Reiki provider health contract",
    "version": "0.15.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "properties": {
                    "age_seconds": {
                      "description": "How old the figures were when sent; readers judge freshness by it plus their own time since receipt, not by observed_at",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "failures": {
                      "additionalProperties": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "description": "Counts of recent key failures by class over a bounded in-memory ring, newest or not; never bodies, key names or streams",
                      "type": "object"
                    },
                    "gateway": {
                      "additionalProperties": true,
                      "description": "Only with expose_usage; aggregate gateway counters, counts only",
                      "properties": {
                        "requests": {
                          "minimum": 0,
                          "type": "integer"
                        },
                        "store_errors": {
                          "minimum": 0,
                          "type": "integer"
                        },
                        "tokens": {
                          "minimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "requests",
                        "tokens",
                        "store_errors"
                      ],
                      "type": "object"
                    },
                    "host": {
                      "additionalProperties": true,
                      "description": "Optional non-core extension: present only with expose_host_stats; off by default",
                      "properties": {
                        "cores": {
                          "type": "integer"
                        },
                        "disks": {
                          "items": {
                            "additionalProperties": true,
                            "description": "Figures are null for a role whose filesystem could not be queried in time",
                            "properties": {
                              "available_bytes": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "roles": {
                                "items": {
                                  "type": "string"
                                },
                                "type": "array"
                              },
                              "total_bytes": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "used_percent": {
                                "type": [
                                  "number",
                                  "null"
                                ]
                              }
                            },
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "load_average": {
                          "items": {
                            "type": "number"
                          },
                          "type": [
                            "array",
                            "null"
                          ]
                        },
                        "memory": {
                          "additionalProperties": true,
                          "properties": {
                            "available_bytes": {
                              "type": "integer"
                            },
                            "swap_free_bytes": {
                              "type": "integer"
                            },
                            "swap_total_bytes": {
                              "type": "integer"
                            },
                            "total_bytes": {
                              "type": "integer"
                            }
                          },
                          "type": [
                            "object",
                            "null"
                          ]
                        }
                      },
                      "type": "object",
                      "x-reiki-default": false,
                      "x-reiki-extension": "host_stats"
                    },
                    "instance": {
                      "type": "string"
                    },
                    "observed": {
                      "description": "Passthrough upstreams observed by the publisher; always present, may be empty",
                      "items": {
                        "additionalProperties": true,
                        "properties": {
                          "account": {
                            "type": "string"
                          },
                          "cooldown_class": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "mode": {
                            "type": "string"
                          },
                          "observed_at": {
                            "type": "string"
                          },
                          "quota": {
                            "additionalProperties": true,
                            "properties": {
                              "requests_limit": {
                                "minimum": 0,
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "requests_remaining": {
                                "minimum": 0,
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "requests_reset_seconds": {
                                "minimum": 0,
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "tokens_limit": {
                                "minimum": 0,
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "tokens_remaining": {
                                "minimum": 0,
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "tokens_reset_seconds": {
                                "minimum": 0,
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "requests_limit",
                              "requests_remaining",
                              "requests_reset_seconds",
                              "tokens_limit",
                              "tokens_remaining",
                              "tokens_reset_seconds"
                            ],
                            "type": "object"
                          },
                          "retry_after_seconds": {
                            "minimum": 0,
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "status_class": {
                            "type": "string"
                          },
                          "upstream": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "upstream",
                          "account",
                          "mode",
                          "status_class",
                          "observed_at",
                          "retry_after_seconds",
                          "cooldown_class",
                          "quota"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "observed_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "reiki_version": {
                      "description": "The publisher's version, sanitised for terminal display",
                      "maxLength": 32,
                      "type": "string"
                    },
                    "requestlog_export_dropped_total": {
                      "description": "Summary records dropped by the bounded queue or failed syslog sends; present when the request-log export reports drops",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "sessions": {
                      "additionalProperties": true,
                      "description": "Optional non-core extension: present only with expose_host_stats; streams only with expose_key_labels too. Counts are client-reported and can be inflated by a token holder. Off by default",
                      "properties": {
                        "active_sessions": {
                          "description": "Client-reported distinct values of session_header in the window, not a count of verified devices",
                          "type": "integer"
                        },
                        "streams": {
                          "items": {
                            "additionalProperties": true,
                            "properties": {
                              "active_sessions": {
                                "description": "Client-reported distinct values of session_header for this stream",
                                "type": "integer"
                              },
                              "stream": {
                                "type": "string"
                              }
                            },
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "window_seconds": {
                          "type": "integer"
                        }
                      },
                      "type": "object",
                      "x-reiki-default": false,
                      "x-reiki-extension": "host_stats"
                    },
                    "streams": {
                      "additionalProperties": true,
                      "description": "Only with expose_usage; aggregate stream counts",
                      "properties": {
                        "dynamic_streams": {
                          "minimum": 0,
                          "type": "integer"
                        },
                        "static_streams": {
                          "minimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "static_streams",
                        "dynamic_streams"
                      ],
                      "type": "object"
                    },
                    "upstreams": {
                      "items": {
                        "additionalProperties": true,
                        "properties": {
                          "capacity_group": {
                            "description": "Opaque, operator-set group for this upstream; only when [upstream.NAME] capacity_group is configured, never derived from a key label or response",
                            "maxLength": 64,
                            "pattern": "^[ -~]+$",
                            "type": "string"
                          },
                          "cooling_combinations": {
                            "description": "How many (route, model) combinations are cooling on this upstream's keys; a count only, never names",
                            "minimum": 0,
                            "type": "integer"
                          },
                          "cooling_keys": {
                            "minimum": 0,
                            "type": "integer"
                          },
                          "disabled_keys": {
                            "minimum": 0,
                            "type": "integer"
                          },
                          "healthy_keys": {
                            "minimum": 0,
                            "type": "integer"
                          },
                          "keys": {
                            "description": "Only with expose_key_labels",
                            "items": {
                              "additionalProperties": true,
                              "properties": {
                                "cooldown_class": {
                                  "description": "Only while cooling, and only when the class is known; readers ignore unknown values",
                                  "type": "string"
                                },
                                "cooldown_seconds": {
                                  "type": [
                                    "integer",
                                    "null"
                                  ]
                                },
                                "name": {
                                  "type": "string"
                                },
                                "quota_reset_at": {
                                  "description": "RFC3339 UTC reset behind a quota cooldown, when the key names a reset schedule or the response supplied Retry-After; only for a cooling quota key",
                                  "format": "date-time",
                                  "type": "string"
                                },
                                "state": {
                                  "description": "available, cooling, out_of_rotation; readers ignore unknown values",
                                  "type": "string"
                                }
                              },
                              "type": "object"
                            },
                            "type": "array"
                          },
                          "last_status_class": {
                            "description": "2xx, 4xx, 5xx, or null before one; readers ignore unknown values",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "limited_1h": {
                            "description": "Attempts that were rate-limited or began a cooldown in the last 60 minutes; only with expose_usage",
                            "minimum": 0,
                            "type": "integer"
                          },
                          "name": {
                            "type": "string"
                          },
                          "request_buckets": {
                            "description": "Twelve five-minute attempt counts, oldest first, newest last; only with expose_usage",
                            "items": {
                              "minimum": 0,
                              "type": "integer"
                            },
                            "maxItems": 12,
                            "minItems": 12,
                            "type": "array"
                          },
                          "request_minutes": {
                            "description": "Ten one-minute attempt counts ending at the current minute, oldest first, newest last; only with expose_usage",
                            "items": {
                              "minimum": 0,
                              "type": "integer"
                            },
                            "maxItems": 10,
                            "minItems": 10,
                            "type": "array"
                          },
                          "requests_1h": {
                            "description": "Attempts in the last 60 minutes; only with expose_usage, a count only",
                            "minimum": 0,
                            "type": "integer"
                          },
                          "soonest_cooldown_seconds": {
                            "description": "Rounded up to a multiple of cooldown_bucket_secs, unless it is 0",
                            "minimum": 1,
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "token_buckets": {
                            "description": "Twelve five-minute token counts, oldest first, newest last; only with expose_usage",
                            "items": {
                              "minimum": 0,
                              "type": "integer"
                            },
                            "maxItems": 12,
                            "minItems": 12,
                            "type": "array"
                          },
                          "token_minutes": {
                            "description": "Ten one-minute token counts ending at the current minute, oldest first, newest last; only with expose_usage",
                            "items": {
                              "minimum": 0,
                              "type": "integer"
                            },
                            "maxItems": 10,
                            "minItems": 10,
                            "type": "array"
                          },
                          "tokens_1h": {
                            "description": "Input plus output tokens of the responses served by this upstream in the last 60 minutes; only with expose_usage",
                            "minimum": 0,
                            "type": "integer"
                          }
                        },
                        "required": [
                          "name",
                          "healthy_keys",
                          "cooling_keys",
                          "disabled_keys",
                          "cooling_combinations",
                          "soonest_cooldown_seconds",
                          "last_status_class"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "instance",
                    "reiki_version",
                    "observed_at",
                    "age_seconds",
                    "failures",
                    "upstreams",
                    "observed"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or wrong peer token"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too many failed peer logins from this address"
          }
        },
        "security": [
          {
            "peerAuth": []
          }
        ],
        "summary": "Coarse key health per upstream, for peers"
      }
    },
    "/v1/health/stream": {
      "get": {
        "description": "event: snapshot carries the /v1/health document; event: key carries {observed_at, age_seconds, upstream} for one upstream whose key counts or states changed; event: sessions and event: host carry {observed_at, sessions|host} with expose_host_stats; a `: heartbeat` comment comes every 15 s",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or wrong peer token"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too many failed logins, or max_subscribers_per_peer streams open from this address, or max_subscribers_per_token with this token"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "max_subscribers streams are open"
          }
        },
        "security": [
          {
            "peerAuth": []
          }
        ],
        "summary": "Server-Sent Events: a snapshot, then key, sessions and host events"
      }
    }
  }
}
